# =================================================================
# BIG DATA TP1 LAB COMPANION - ENVIRONMENT VARIABLES
# =================================================================

# 1. SERVER CONFIGURATION
PORT=3000
NODE_ENV=development

# 2. MONGODB ATLAS (NoSQL Database for sessions, evidence, reports)
# Ganti dengan connection string dari MongoDB Atlas:
# Contoh: mongodb+srv://username:password@cluster0.abcde.mongodb.net/bigdata_tp1?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bigdata_tp1?retryWrites=true&w=majority"
MONGODB_DB_NAME="bigdata_tp1"

# 3. SUPABASE (PostgreSQL & Object Storage)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. OPTIONAL AI & HOSTING
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
